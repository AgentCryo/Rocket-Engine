vec3 ComputeLight(Light light) {
    uint type          = GetLightType(light.data);
    bool smoothFalloff = GetSmoothFalloff(light.data);
    bool isGlobal      = IsGlobalLight(light.data);

    vec3 N = DecodeNormal(norm);

    // DIRECTIONAL LIGHTS
    if (type == LIGHT_DIRECTIONAL)
    {
        vec3 Ldir = normalize(-light.direction);

        if (isGlobal) {
            float ndotl = max(dot(N, Ldir), 0.0);
            return ndotl * color * light.color * light.intensity;
        } else {
            float dist = length(light.position - position);
            if (dist > light.radius) return vec3(0.0);

            float atten = smoothFalloff ? ComputeAttenuation(dist, light.radius, true) : 1.0;

            float ndotl = max(dot(N, Ldir), 0.0);
            return ndotl * color * light.color * light.intensity * atten;
        }
    }

    // POINT & SPOT LIGHTS
    vec3 toLight   = light.position - position;
    float dist     = length(toLight);
    vec3 lightDir  = normalize(toLight);

    if (!isGlobal && dist > light.radius) return vec3(0.0);

    if (type == LIGHT_SPOT) {
        vec3 lightToFrag = normalize(position - light.position);
        float theta      = dot(lightToFrag, normalize(light.direction));
        if (theta <= cos(light.angle)) return vec3(0.0);
    }
    float attenuation = 1.0 / max(dist * dist, 0.0001);

    if (!isGlobal && smoothFalloff) {
        float fade = 1.0 - smoothstep(light.radius * 0.8, light.radius, dist);
        attenuation *= fade;
    }

    float ndotl = max(dot(N, lightDir), 0.0);
    return ndotl * color * light.color * light.intensity * attenuation;
}

float ComputeAttenuation(float dist, float radius, bool smoothFalloff)
{
    if (dist >= radius) return 0.0;

    float pbr = 1.0 / max(dist * dist, 0.0001);

    if (!smoothFalloff) return pbr;

    // Smooth fade near the edge
    float fade = 1.0 - smoothstep(radius * 0.8, radius, dist);

    return pbr * fade;
}